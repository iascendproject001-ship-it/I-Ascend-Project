# I Ascend Project — required server secrets.
# Copy this file to `.env` for local work, or enter the same values in your
# hosting provider's environment-variable settings for production.
# Never commit real values to version control.

# PostgreSQL connection string (server-side only).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Canonical public address of the site, used for the flyer QR code and links.
NEXT_PUBLIC_SITE_URL=https://your-domain.org

# Set to "true" in production so the demonstration learner, mock scores and
# demo dashboard button are never created or shown. Leave unset for previews.
DISABLE_DEMO_SEED=false

# Optional: cap simultaneous database connections (default 10).
# Lower to 3-5 on small shared database tiers.
# PGPOOL_MAX=10
